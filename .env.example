# Firebase web config — copy this file to .env.local and fill in the
# values from the Firebase console:
#   Project settings > General > Your apps > SDK setup and configuration
#
# .env.local is gitignored. These values are NOT secret (they ship in the
# JS bundle either way) — the file is gitignored so each environment can
# point at a different project, not to hide them.
#
# Create React App reads these at STARTUP, so restart `npm start` after
# changing them.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
