rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors isTeacher() in firestore.rules: a teacher record the admin
    // has approved. A sign-up request that is still pending, or was
    // rejected, can't listen to anyone. Records from before sign-ups were
    // verified have no status and count as approved.
    //
    // Needs the Storage service agent's Firestore grant - see
    // FIREBASE-SETUP.md - or every teacher is silently denied.
    function isApprovedTeacher() {
      return firestore.exists(/databases/(default)/documents/teachers/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/teachers/$(request.auth.uid)).data.get('status', 'approved') == 'approved';
    }

    // Recitation audio, stored at attempts/{studentUid}/{attemptId}.webm
    // A student can upload/read only their own recordings; an approved
    // teacher can read any student's recordings for review.
    match /attempts/{uid}/{fileName} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isApprovedTeacher());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
